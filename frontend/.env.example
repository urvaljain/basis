# The API origin the Next.js server proxies /api/* to.
# Server-side only — deliberately NOT NEXT_PUBLIC_*, so the backend URL is neither
# baked into the client bundle nor exposed to the browser, and changing it does not
# require a rebuild.
#
# Local development needs nothing: it defaults to http://127.0.0.1:8000.
# API_ORIGIN=https://basis-api.up.railway.app
