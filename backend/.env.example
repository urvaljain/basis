# Optional. Without either key Basis runs in extractive mode, which is a supported mode:
# every claim is a verbatim passage with a citation, and no prose is generated.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional model override. Defaults: claude-sonnet-5 (Anthropic) / gpt-4o (OpenAI).
# BASIS_MODEL=claude-sonnet-5
